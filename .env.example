# Either DATABASE_URL, or the DB_* variables below.
# DATABASE_URL=postgres://user:pass@host:5432/golog?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=golog
# disable | require | verify-ca | verify-full
DB_SSLMODE=disable

PORT=8080
# Comma-separated origins allowed to call the API from a browser. Empty = no CORS.
CORS_ALLOWED_ORIGINS=
# Apply schema migrations on server start.
GOLOG_AUTO_MIGRATE=true

# Tokens (16+ characters each, different from each other). Unset = open.
# Generate with: openssl rand -hex 24
# GOLOG_READ_TOKEN=
# GOLOG_WRITE_TOKEN=
# GOLOG_SECURE_COOKIES=false

# Delete logs older than N days, hourly. 0 keeps everything. Deletion is permanent.
GOLOG_RETENTION_DAYS=0

# golog-cli only: read this server over HTTP instead of the database.
# GOLOG_URL=https://logs.example.com 